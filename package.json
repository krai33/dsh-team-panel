{
  "name": "dsh-team-panel",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness Web 插件：会话头部 Agent team 下拉面板（成员花名册 + 当前模型 + 共享任务 + 可配置成员头像），数据来自 stock 投影。",
  "type": "module",
  "main": "./lib/host/index.js",
  "types": "./lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./assets/*": "./data/assets/*"
  },
  "files": [
    "lib/host/**/*.js",
    "lib/host/**/*.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "data/assets/.gitkeep",
    "data/assets/*",
    "data/avatars.json"
  ],
  "scripts": {
    "build": "node node_modules-sibling/typescript/bin/tsc -p tsconfig.json && node scripts/typecheck-client.mjs && node node_modules-sibling/.bin/tsdown -c tsdown.client.config.ts",
    "typecheck": "node scripts/typecheck-client.mjs"
  },
  "bin": {},
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "engines": {
    "node": ">=24.9"
  },
  "license": "MIT"
}